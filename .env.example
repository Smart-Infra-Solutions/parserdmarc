# ── Microsoft Graph / Azure AD app registration ───────────────────────────
# Created in Azure portal > App registrations. The app needs the APPLICATION
# permission Mail.ReadWrite (and Mail.Read.Shared is implied for shared boxes),
# ideally scoped to just this mailbox via RBAC for Applications (see README).
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret
# Primary SMTP address / UPN of the shared mailbox holding the DMARC reports
GRAPH_MAILBOX=abuse@example.com

# National cloud overrides (defaults shown). Leave as-is for commercial O365.
# GRAPH_AUTHORITY=https://login.microsoftonline.com
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# ── Mailbox processing ────────────────────────────────────────────────────
# Well-known folder name (inbox, archive, …) or a Graph folder ID.
REPORTS_FOLDER=inbox
ARCHIVE_FOLDER=archive
# move | mark_read | delete | none   (how to dispose of a processed message)
POST_PROCESS_ACTION=move
BATCH_SIZE=50

# ── Scheduling ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
# RUN_ONCE=false        # set true for a single poll then exit (cron/testing)

# ── Storage ───────────────────────────────────────────────────────────────
STORAGE_DIR=/data
SAVE_ATTACHMENTS=true
SAVE_PARSED_JSON=true

# ── Parsing ───────────────────────────────────────────────────────────────
# OFFLINE_DNS=false     # true = skip reverse-DNS/GeoIP lookups

# ── Metrics ───────────────────────────────────────────────────────────────
METRICS_PORT=9797
# Per-source-IP metrics are high cardinality — enable only if you need them.
EXPORT_SOURCE_IP_METRICS=false

LOG_LEVEL=INFO
